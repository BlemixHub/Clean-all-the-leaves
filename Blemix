local function createToggle(parent, label, onChange)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -2, 0, 42)
    row.BackgroundColor3 = Colors.Element
    row.BorderSizePixel  = 0
    row.Parent = parent
    addCorner(row, 6)

    local textLabel = Instance.new("TextLabel")
    textLabel.Size               = UDim2.new(1, -65, 1, 0)
    textLabel.Position           = UDim2.fromOffset(12, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text               = label
    textLabel.Font               = Enum.Font.Gotham
    textLabel.TextSize           = 13
    textLabel.TextColor3         = Colors.Text
    textLabel.TextXAlignment     = Enum.TextXAlignment.Left
    textLabel.TextTruncate       = Enum.TextTruncate.AtEnd
    textLabel.Parent = row

    local pill = Instance.new("TextButton")
    pill.Size             = UDim2.fromOffset(40, 22)
    pill.Position         = UDim2.new(1, -50, 0.5, -11)
    pill.BackgroundColor3 = Colors.Off
    pill.BorderSizePixel  = 0
    pill.Text             = ""
    pill.AutoButtonColor  = false
    pill.Parent = row
    addCorner(pill, 99)

    local knob = Instance.new("Frame")
    knob.Size             = UDim2.fromOffset(16, 16)
    knob.Position         = UDim2.new(0, 3, 0.5, -8)
    knob.BackgroundColor3 = Color3.fromRGB(235, 235, 235)
    knob.BorderSizePixel  = 0
    knob.Parent = pill
    addCorner(knob, 99)

    local state = false
    local tweenInfo = TweenInfo.new(0.15)

    local function flip()
        state = not state
        TweenService:Create(pill, tweenInfo, {
            BackgroundColor3 = state and Colors.On or Colors.Off
        }):Play()
        TweenService:Create(knob, tweenInfo, {
            Position = state
                and UDim2.new(1, -19, 0.5, -8)
                or  UDim2.new(0,   3, 0.5, -8)
        }):Play()
        onChange(state)
    end

    pill.MouseButton1Click:Connect(flip)

    local hitArea = Instance.new("TextButton")
    hitArea.Size                 = UDim2.new(1, -60, 1, 0)
    hitArea.BackgroundTransparency = 1
    hitArea.Text                 = ""
    hitArea.AutoButtonColor      = false
    hitArea.MouseButton1Click:Connect(flip)
    hitArea.Parent = row

    return row
end

