local leafModule     = nil  
local leavesFolder   = nil  
local lastScanClock  = 0

local function isLeafModule(t)
    if type(t) ~= "table" then return false end
    if not leavesFolder then return false end
    if rawget(t, "folder") ~= leavesFolder then return false end
    return type(rawget(t, "collectMany")) == "function"
        or type(rawget(t, "collect"))     == "function"
end

local function ensureLeafSystem()
    if leafModule and leavesFolder and leavesFolder.Parent then
        return true
    end

    if os.clock() - lastScanClock < 2 then return false end
    lastScanClock = os.clock()

    leavesFolder = Workspace:FindFirstChild("Leaves")
    if not leavesFolder then return false end

    if type(getgc) == "function" then
        local ok, gcList = pcall(getgc, true)
        if ok and type(gcList) == "table" then
            for _, v in ipairs(gcList) do
                if isLeafModule(v) then
                    leafModule = v
                    return true
                end
            end
        end
    end

    if type(getloadedmodules) == "function" then
        local ok, modules = pcall(getloadedmodules)
        if ok and type(modules) == "table" then
            for _, mod in ipairs(modules) do
                if typeof(mod) == "Instance"
                    and mod:IsA("ModuleScript")
                    and string.find(string.lower(mod.Name), "leaf", 1, true)
                then
                    local ok2, result = pcall(require, mod)
                    if ok2 and isLeafModule(result) then
                        leafModule = result
                        return true
                    end
                end
            end
        end
    end

    local leafSimScript = ReplicatedStorage:FindFirstChild("LeafSim", true)
    if leafSimScript and leafSimScript:IsA("ModuleScript") then
        local ok, result = pcall(require, leafSimScript)
        if ok and isLeafModule(result) then
            leafModule = result
            return true
        end
    end

    return false
end

local function getRootPart()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart") or nil
end

local function getCollectBudget()
    if not leafModule then return 0 end
    local fn = rawget(leafModule, "collectBudget")
    if type(fn) ~= "function" then return 6 end
    local ok, result = pcall(fn)
    if not ok or type(result) ~= "number" then return 6 end
    return math.max(0, math.floor(result))
end

local leafOverlapParams = OverlapParams.new()
leafOverlapParams.FilterType = Enum.RaycastFilterType.Include
leafOverlapParams.MaxParts   = 100

local function getNearbyLeaves(maxCount)
    local root = getRootPart()
    if not root or not leavesFolder or not leavesFolder.Parent then
        return {}
    end

    leafOverlapParams.FilterDescendantsInstances = { leavesFolder }

    local found = {}
    for _, radius in ipairs(SEARCH_RADII) do
        found = Workspace:GetPartBoundsInRadius(root.Position, radius, leafOverlapParams)
        if #found > 0 then break end
    end

    if #found == 0 then return {} end

    local origin = root.Position
    local candidates = {}
    for _, part in ipairs(found) do
        if part:IsA("BasePart") and part.Parent == leavesFolder and part.CanQuery then
            local d = part.Position - origin
            candidates[#candidates + 1] = { part, d.X*d.X + d.Y*d.Y + d.Z*d.Z }
        end
    end
    table.sort(candidates, function(a, b) return a[2] < b[2] end)

    local result = {}
    for i = 1, math.min(maxCount, #candidates) do
        result[i] = candidates[i][1]
    end
    return result
end

task.spawn(function()
    while task.wait(0.11) do
        if Config.AutoCollect and ensureLeafSystem() then
            local budget = getCollectBudget()
            if budget > 0 then
                local leaves = getNearbyLeaves(math.min(budget, 6))
                if #leaves > 0 then
                    local collectMany = rawget(leafModule, "collectMany")
                    local collect     = rawget(leafModule, "collect")
                    if type(collectMany) == "function" then
                        pcall(collectMany, leaves)
                    elseif type(collect) == "function" then
                        for _, leaf in ipairs(leaves) do
                            if not Config.AutoCollect then break end
                            if leaf and leaf.Parent == leavesFolder then
                                pcall(collect, leaf)
                            end
                        end
                    end
                end
            end
        end
    end
end)

local nextSellTime    = 0
local nextUpgradeTime = {}

task.spawn(function()
    while task.wait(0.08) do
        local now = os.clock()

        if Config.AutoSell and now >= nextSellTime then
            nextSellTime = now + 0.5
            pcall(function() EmptyBackpack:FireServer() end)
        end

        for i, def in ipairs(UPGRADE_DEFS) do
            if Config.Upgrades[i] and now >= (nextUpgradeTime[i] or 0) then
                nextUpgradeTime[i] = now + 1
                pcall(function() BuyUpgrade:FireServer(def[3], def[4]) end)
            end
        end
    end
end)

