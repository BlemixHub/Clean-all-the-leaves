local isMinimised = false

local function applyResponsiveSize()
    if isMinimised then return end

    local camera = Workspace.CurrentCamera
    if not camera then return end

    local vp = camera.ViewportSize
    local w  = math.clamp(vp.X - 18, 285, 430)
    local h  = math.clamp(vp.Y - 65, 220, 300)
    mainFrame.Size = UDim2.fromOffset(w, h)

    if w <= 345 then
        sidebarFrame.Size    = UDim2.new(0, 82, 1, 0)
        contentArea.Position = UDim2.fromOffset(82, 0)
        contentArea.Size     = UDim2.new(1, -82, 1, 0)
        for _, btn in pairs(tabButtons) do btn.TextSize = 10 end
        titleLabel.TextSize  = 13
    else
        sidebarFrame.Size    = UDim2.new(0, 105, 1, 0)
        contentArea.Position = UDim2.fromOffset(105, 0)
        contentArea.Size     = UDim2.new(1, -105, 1, 0)
        for _, btn in pairs(tabButtons) do btn.TextSize = 12 end
        titleLabel.TextSize  = 16
    end
end

applyResponsiveSize()

if Workspace.CurrentCamera then
    Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(applyResponsiveSize)
end

local isDragging    = false
local dragInput     = nil
local dragStart     = nil
local frameStartPos = nil

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        isDragging    = true
        dragStart     = input.Position
        frameStartPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                isDragging = false
            end
        end)
    end
end)

titleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isDragging and input == dragInput then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(
            frameStartPos.X.Scale,  frameStartPos.X.Offset + delta.X,
            frameStartPos.Y.Scale,  frameStartPos.Y.Offset + delta.Y
        )
    end
end)

